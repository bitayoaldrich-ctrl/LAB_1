import React, { useState, useEffect, useCallback } from 'react';
import { 
  Calculator, 
  Delete, 
  RotateCcw, 
  HelpCircle, 
  CheckCircle, 
  Moon, 
  Sun,
  Keyboard
} from 'lucide-react';

export default function App() {
  const [display, setDisplay] = useState('0');
  const [prevValue, setPrevValue] = useState(null);
  const [operation, setOperation] = useState(null);
  const [waitingForOperand, setWaitingForOperand] = useState(false);
  const [history, setHistory] = useState([]);
  const [isDarkMode, setIsDarkMode] = useState(false);
  const [activeTab, setActiveTab] = useState('calculator');

  // Automatic Tailwind CSS loader
  useEffect(() => {
    if (!document.getElementById('tailwind-cdn')) {
      const script = document.createElement('script');
      script.id = 'tailwind-cdn';
      script.src = 'https://cdn.tailwindcss.com';
      document.head.appendChild(script);
    }
  }, []);

  const clearAll = () => {
    setDisplay('0');
    setPrevValue(null);
    setOperation(null);
    setWaitingForOperand(false);
  };

  const deleteLastChar = () => {
    if (waitingForOperand) return;
    if (display.length === 1 || display === 'Error') {
      setDisplay('0');
    } else {
      setDisplay(display.slice(0, -1));
    }
  };

  const inputDigit = (digit) => {
    if (waitingForOperand) {
      setDisplay(String(digit));
      setWaitingForOperand(false);
    } else {
      setDisplay(display === '0' ? String(digit) : display + digit);
    }
  };

  const inputDecimal = () => {
    if (waitingForOperand) {
      setDisplay('0.');
      setWaitingForOperand(false);
      return;
    }
    if (!display.includes('.')) {
      setDisplay(display + '.');
    }
  };

  const performOperation = (nextOperation) => {
    const inputValue = parseFloat(display);

    if (prevValue === null) {
      setPrevValue(inputValue);
    } else if (operation) {
      const currentValue = prevValue || 0;
      const result = calculate(currentValue, inputValue, operation);

      if (result === 'Error') {
        setDisplay('Error');
        setPrevValue(null);
        setOperation(null);
        setWaitingForOperand(true);
        return;
      }

      setPrevValue(result);
      setDisplay(String(result));
      setHistory(prev => [`${currentValue} ${operation} ${inputValue} = ${result}`, ...prev.slice(0, 4)]);
    }

    setWaitingForOperand(true);
    setOperation(nextOperation);
  };

  const calculate = (first, second, op) => {
    switch (op) {
      case '+': return first + second;
      case '-': return first - second;
      case '×': return first * second;
      case '÷': 
        if (second === 0) return 'Error';
        return parseFloat((first / second).toFixed(8));
      default: return second;
    }
  };

  const handleEquals = () => {
    if (!operation || prevValue === null) return;
    const inputValue = parseFloat(display);
    const result = calculate(prevValue, inputValue, operation);

    if (result === 'Error') {
      setDisplay('Error');
    } else {
      setDisplay(String(result));
      setHistory(prev => [`${prevValue} ${operation} ${inputValue} = ${result}`, ...prev.slice(0, 4)]);
    }

    setPrevValue(null);
    setOperation(null);
    setWaitingForOperand(true);
  };

  const handleKeyDown = useCallback((event) => {
    const { key } = event;

    if (/\d/.test(key)) {
      inputDigit(parseInt(key, 10));
    } else if (key === '.') {
      inputDecimal();
    } else if (key === '+') {
      performOperation('+');
    } else if (key === '-') {
      performOperation('-');
    } else if (key === '*') {
      performOperation('×');
    } else if (key === '/') {
      event.preventDefault();
      performOperation('÷');
    } else if (key === 'Enter' || key === '=') {
      event.preventDefault();
      handleEquals();
    } else if (key === 'Backspace') {
      deleteLastChar();
    } else if (key === 'Escape') {
      clearAll();
    }
  }, [display, prevValue, operation, waitingForOperand]);

  useEffect(() => {
    window.addEventListener('keydown', handleKeyDown);
    return () => window.removeEventListener('keydown', handleKeyDown);
  }, [handleKeyDown]);

  const toggleTheme = () => setIsDarkMode(!isDarkMode);

  return (
    <div className={`min-h-screen transition-colors duration-300 font-sans ${
      isDarkMode 
        ? 'bg-pink-950 text-pink-100' 
        : 'bg-gradient-to-br from-pink-100 via-emerald-50 to-pink-50 text-slate-800'
    }`}>
      
      {/* Header */}
      <header className={`border-b sticky top-0 z-50 backdrop-blur-md ${
        isDarkMode ? 'bg-pink-950/80 border-pink-900' : 'bg-white/70 border-pink-200'
      }`}>
        <div className="max-w-5xl mx-auto px-4 h-16 flex items-center justify-between">
          <div className="flex items-center space-x-3">
            <div className="p-2.5 rounded-2xl bg-pink-300 text-pink-900 shadow-sm">
              <Calculator className="w-6 h-6" />
            </div>
            <div>
              <h1 className="font-bold text-lg text-pink-900 leading-tight">PastelCalc</h1>
              <p className="text-xs text-pink-600">Interactive Student Project</p>
            </div>
          </div>

          <div className="flex items-center space-x-2">
            <button 
              onClick={() => setActiveTab('calculator')}
              className={`px-3.5 py-1.5 rounded-xl text-sm font-semibold transition-all ${
                activeTab === 'calculator' ? 'bg-pink-300 text-pink-950 shadow-sm' : 'text-pink-700 hover:bg-pink-200/50'
              }`}
            >
              Calculator
            </button>
            <button 
              onClick={() => setActiveTab('guide')}
              className={`px-3.5 py-1.5 rounded-lg text-sm font-semibold transition-all ${
                activeTab === 'guide' ? 'bg-pink-300 text-pink-950 shadow-sm' : 'text-pink-700 hover:bg-pink-200/50'
              }`}
            >
              User Guide
            </button>
            <button 
              onClick={toggleTheme}
              className="p-2 rounded-xl bg-pink-200/60 border border-pink-300 text-pink-700 hover:bg-pink-200"
              aria-label="Toggle Theme"
            >
              {isDarkMode ? <Sun className="w-4 h-4 text-amber-400" /> : <Moon className="w-4 h-4 text-pink-800" />}
            </button>
          </div>
        </div>
      </header>

      {/* Main Content */}
      <main className="max-w-5xl mx-auto px-4 py-8">
        {activeTab === 'calculator' ? (
          <div className="grid grid-cols-1 md:grid-cols-12 gap-8 items-start">
            
            {/* Main Calculator Card */}
            <div className="md:col-span-7 flex justify-center">
              <div className={`w-full max-w-sm rounded-[2rem] p-6 shadow-xl border transition-all ${
                isDarkMode 
                  ? 'bg-pink-900/40 border-pink-800' 
                  : 'bg-white/80 backdrop-blur-md border-pink-200 shadow-pink-200/40'
              }`}>
                
                {/* Screen Display */}
                <div className={`mb-6 p-4 rounded-2xl flex flex-col items-end justify-between min-h-[110px] border transition-all ${
                  isDarkMode ? 'bg-pink-950 border-pink-900' : 'bg-emerald-50/70 border-emerald-200/60'
                }`}>
                  <div className="text-xs font-mono text-emerald-700/70 h-4 font-medium">
                    {prevValue !== null ? `${prevValue} ${operation || ''}` : ''}
                  </div>
                  <div className={`text-4xl font-mono font-bold tracking-tight overflow-x-auto max-w-full ${
                    display === 'Error' ? 'text-rose-600' : isDarkMode ? 'text-pink-100' : 'text-slate-800'
                  }`}>
                    {display}
                  </div>
                </div>

                {/* Keypad */}
                <div className="grid grid-cols-4 gap-3">
                  
                  {/* RED / ROSE BUTTON: Clear AC */}
                  <button 
                    onClick={clearAll}
                    className="col-span-2 py-3.5 rounded-2xl font-bold bg-rose-500 text-white shadow-md shadow-rose-200 hover:bg-rose-600 active:scale-95 transition-all flex items-center justify-center gap-1.5"
                  >
                    <RotateCcw className="w-4 h-4" /> AC
                  </button>

                  {/* RED / ROSE BUTTON: Delete */}
                  <button 
                    onClick={deleteLastChar}
                    className="py-3.5 rounded-2xl font-bold bg-rose-400 text-white shadow-md shadow-rose-100 hover:bg-rose-500 active:scale-95 transition-all flex items-center justify-center"
                  >
                    <Delete className="w-4 h-4" />
                  </button>

                  {/* PASTEL GREEN BUTTON: Division */}
                  <button 
                    onClick={() => performOperation('÷')}
                    className={`py-3.5 rounded-2xl font-bold text-lg shadow-sm transition-all active:scale-95 ${
                      operation === '÷' 
                        ? 'bg-emerald-600 text-white' 
                        : 'bg-emerald-200 text-emerald-900 hover:bg-emerald-300'
                    }`}
                  >
                    ÷
                  </button>

                  {/* PINK PASTEL BUTTONS: Numbers 7, 8, 9 */}
                  {[7, 8, 9].map((num) => (
                    <button
                      key={num}
                      onClick={() => inputDigit(num)}
                      className="py-3.5 rounded-2xl font-bold text-lg bg-pink-100/80 text-pink-900 hover:bg-pink-200 active:scale-95 transition-all shadow-sm border border-pink-200/50"
                    >
                      {num}
                    </button>
                  ))}

                  {/* PASTEL GREEN BUTTON: Multiplication */}
                  <button 
                    onClick={() => performOperation('×')}
                    className={`py-3.5 rounded-2xl font-bold text-lg shadow-sm transition-all active:scale-95 ${
                      operation === '×' 
                        ? 'bg-emerald-600 text-white' 
                        : 'bg-emerald-200 text-emerald-900 hover:bg-emerald-300'
                    }`}
                  >
                    ×
                  </button>

                  {/* PINK PASTEL BUTTONS: Numbers 4, 5, 6 */}
                  {[4, 5, 6].map((num) => (
                    <button
                      key={num}
                      onClick={() => inputDigit(num)}
                      className="py-3.5 rounded-2xl font-bold text-lg bg-pink-100/80 text-pink-900 hover:bg-pink-200 active:scale-95 transition-all shadow-sm border border-pink-200/50"
                    >
                      {num}
                    </button>
                  ))}

                  {/* PASTEL GREEN BUTTON: Subtraction */}
                  <button 
                    onClick={() => performOperation('-')}
                    className={`py-3.5 rounded-2xl font-bold text-lg shadow-sm transition-all active:scale-95 ${
                      operation === '-' 
                        ? 'bg-emerald-600 text-white' 
                        : 'bg-emerald-200 text-emerald-900 hover:bg-emerald-300'
                    }`}
                  >
                    -
                  </button>

                  {/* PINK PASTEL BUTTONS: Numbers 1, 2, 3 */}
                  {[1, 2, 3].map((num) => (
                    <button
                      key={num}
                      onClick={() => inputDigit(num)}
                      className="py-3.5 rounded-2xl font-bold text-lg bg-pink-100/80 text-pink-900 hover:bg-pink-200 active:scale-95 transition-all shadow-sm border border-pink-200/50"
                    >
                      {num}
                    </button>
                  ))}

                  {/* PASTEL GREEN BUTTON: Addition */}
                  <button 
                    onClick={() => performOperation('+')}
                    className={`py-3.5 rounded-2xl font-bold text-lg shadow-sm transition-all active:scale-95 ${
                      operation === '+' 
                        ? 'bg-emerald-600 text-white' 
                        : 'bg-emerald-200 text-emerald-900 hover:bg-emerald-300'
                    }`}
                  >
                    +
                  </button>

                  {/* PINK PASTEL BUTTON: 0 */}
                  <button 
                    onClick={() => inputDigit(0)}
                    className="col-span-2 py-3.5 rounded-2xl font-bold text-lg bg-pink-100/80 text-pink-900 hover:bg-pink-200 active:scale-95 transition-all shadow-sm border border-pink-200/50"
                  >
                    0
                  </button>

                  {/* PINK PASTEL BUTTON: Decimal */}
                  <button 
                    onClick={inputDecimal}
                    className="py-3.5 rounded-2xl font-bold text-lg bg-pink-100/80 text-pink-900 hover:bg-pink-200 active:scale-95 transition-all shadow-sm border border-pink-200/50"
                  >
                    .
                  </button>

                  {/* PASTEL GREEN / EMERALD BUTTON: Equals */}
                  <button 
                    onClick={handleEquals}
                    className="py-3.5 rounded-2xl font-bold text-lg bg-emerald-400 text-emerald-950 hover:bg-emerald-500 shadow-md shadow-emerald-200 transition-all active:scale-95"
                  >
                    =
                  </button>
                </div>
              </div>
            </div>

            {/* Side Panel */}
            <div className="md:col-span-5 space-y-6">
              <div className={`p-6 rounded-3xl border ${isDarkMode ? 'bg-pink-900/30 border-pink-800' : 'bg-white/60 border-pink-200'}`}>
                <h3 className="font-bold text-base mb-3 flex items-center gap-2 text-pink-900">
                  <RotateCcw className="w-4 h-4 text-emerald-600" /> Recent Calculations
                </h3>
                {history.length === 0 ? (
                  <p className="text-sm text-pink-400 italic">No calculations performed yet.</p>
                ) : (
                  <ul className="space-y-2 font-mono text-sm">
                    {history.map((item, idx) => (
                      <li key={idx} className="p-2.5 rounded-xl border bg-emerald-50/50 border-emerald-200 text-emerald-900">
                        {item}
                      </li>
                    ))}
                  </ul>
                )}
              </div>

              <div className={`p-6 rounded-3xl border ${isDarkMode ? 'bg-pink-900/30 border-pink-800' : 'bg-white/60 border-pink-200'}`}>
                <h3 className="font-bold text-base mb-3 flex items-center gap-2 text-pink-900">
                  <Keyboard className="w-4 h-4 text-emerald-600" /> Keyboard Shortcuts
                </h3>
                <div className="grid grid-cols-2 gap-2 text-xs">
                  <div className="p-2.5 rounded-xl bg-pink-100/60 text-pink-900">Numpad / Numbers: <span className="font-bold">0-9</span></div>
                  <div className="p-2.5 rounded-xl bg-emerald-100/60 text-emerald-900">Operators: <span className="font-bold">+ - * /</span></div>
                  <div className="p-2.5 rounded-xl bg-emerald-100/60 text-emerald-900">Calculate: <span className="font-bold">Enter / =</span></div>
                  <div className="p-2.5 rounded-xl bg-rose-100/60 text-rose-900">Clear: <span className="font-bold">Esc</span></div>
                </div>
              </div>
            </div>

          </div>
        ) : (
          /* User Guide Section */
          <div className={`max-w-3xl mx-auto rounded-3xl p-8 border ${isDarkMode ? 'bg-pink-900/40 border-pink-800' : 'bg-white/80 border-pink-200'}`}>
            <h2 className="text-2xl font-bold mb-4 flex items-center gap-2 text-pink-900">
              <HelpCircle className="w-6 h-6 text-emerald-600" /> User Guide & Instructions
            </h2>
            <p className="text-pink-700 mb-6 leading-relaxed">
              Welcome to PastelCalc. Designed with a clean pastel theme supporting full arithmetic functionalities.
            </p>

            <div className="space-y-6">
              <div>
                <h3 className="text-lg font-bold mb-2 text-emerald-700">Supported Operations</h3>
                <ul className="grid grid-cols-1 md:grid-cols-2 gap-3 text-sm">
                  <li className="p-3 rounded-2xl border border-pink-200 bg-pink-50/50 flex items-start gap-2">
                    <CheckCircle className="w-4 h-4 text-emerald-600 mt-0.5" />
                    <span><strong>Addition (+):</strong> Combines values.</span>
                  </li>
                  <li className="p-3 rounded-2xl border border-pink-200 bg-pink-50/50 flex items-start gap-2">
                    <CheckCircle className="w-4 h-4 text-emerald-600 mt-0.5" />
                    <span><strong>Subtraction (-):</strong> Finds difference.</span>
                  </li>
                  <li className="p-3 rounded-2xl border border-pink-200 bg-pink-50/50 flex items-start gap-2">
                    <CheckCircle className="w-4 h-4 text-emerald-600 mt-0.5" />
                    <span><strong>Multiplication (×):</strong> Multiplies factors.</span>
                  </li>
                  <li className="p-3 rounded-2xl border border-pink-200 bg-pink-50/50 flex items-start gap-2">
                    <CheckCircle className="w-4 h-4 text-emerald-600 mt-0.5" />
                    <span><strong>Division (÷):</strong> Divides numbers with zero error check.</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>
        )}
      </main>

      {/* Footer */}
      <footer className="border-t border-pink-200/60 mt-12 py-6 text-center text-xs text-pink-500">
        <p>Built with React & Tailwind CSS • Pastel Theme Edition</p>
      </footer>
    </div>
  );
}
